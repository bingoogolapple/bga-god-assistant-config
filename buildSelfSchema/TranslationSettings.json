{
  "form": {
    "labelCol": 6,
    "wrapperCol": 16
  },
  "schema": {
    "type": "object",
    "properties": {
      "translationSettingsCardDiv": {
        "type": "void",
        "x-component": "Div",
        "x-component-props": {
          "style": {
            "padding": "20px"
          }
        },
        "name": "translationSettingsCardDiv",
        "x-reactions": {
          "fulfill": {
            "run": "$utils.setAsBlockRoot($self)\nconst rootEntire = $self.address.entire\nconst CONFIG_KEY = 'translationConfig'\nconst MODEL_KEY = 'modelProviderConfig'\n$self.state = $observable({ translationConfig: null, modelProviderConfig: [], selectedProviderId: '' })\nconst DEFAULT_CONFIG = {\n  enabled: false,\n  providerId: 'deepseek',\n  modelId: 'deepseek-v4-flash',\n  targetLang: '简体中文',\n  sourceLang: 'auto',\n  displayMode: 'bilingual',\n  autoTranslate: false,\n  concurrency: 4,\n  showBall: true,\n  hoverTranslate: true,\n  dynamicTranslate: true,\n  cache: true,\n  paragraphShortcut: 'double-ctrl'\n}\n$self.loadModelProviders = async () => {\n  const res = await $chrome.storage.local.get(MODEL_KEY)\n  $self.state.modelProviderConfig = (res && Array.isArray(res[MODEL_KEY])) ? res[MODEL_KEY] : []\n}\n$self.loadTranslationConfig = async () => {\n  const res = await $chrome.storage.local.get(CONFIG_KEY)\n  const cfg = res && res[CONFIG_KEY] && typeof res[CONFIG_KEY] === 'object' ? res[CONFIG_KEY] : null\n  $self.state.translationConfig = cfg || DEFAULT_CONFIG\n  $self.state.selectedProviderId = (cfg || DEFAULT_CONFIG).providerId || ''\n}\n$self.saveTranslationConfig = async (config) => {\n  const plain = JSON.parse(JSON.stringify(config || {}))\n  await $chrome.storage.local.set({ [CONFIG_KEY]: plain })\n  $self.state.translationConfig = plain\n}\n$effect(() => {\n  (async () => {\n    await $self.loadModelProviders()\n    await $self.loadTranslationConfig()\n  })()\n}, [])\n"
          }
        },
        "properties": {
          "headerDiv": {
            "type": "void",
            "x-component": "Div",
            "x-component-props": {
              "style": {
                "display": "flex",
                "justifyContent": "space-between",
                "alignItems": "center",
                "margin": "0px 0px 16px 0px"
              }
            },
            "properties": {
              "enableGroup": {
                "type": "void",
                "x-component": "Div",
                "x-component-props": {
                  "style": {
                    "display": "flex",
                    "alignItems": "center",
                    "gap": "8px"
                  }
                },
                "properties": {
                  "enableLabel": {
                    "type": "void",
                    "x-component": "Text",
                    "x-component-props": {
                      "content": "翻译总开关：",
                      "style": {
                        "color": "#262626",
                        "fontSize": "14px",
                        "fontWeight": 500
                      }
                    }
                  },
                  "enabled": {
                    "type": "boolean",
                    "x-component": "Switch",
                    "default": false,
                    "x-reactions": {
                      "fulfill": {
                        "run": "const rf = $utils.getBlockRootField($self)\nif (!rf) return\n$props({ onChange: async (val) => {\n  const formField = rf.query(rf.address.entire + '.translationConfigForm').take()\n  if (!formField || !formField.value) return\n  formField.value.enabled = val\n  await rf.saveTranslationConfig(formField.value)\n  $message.success(val ? '翻译功能已开启' : '翻译功能已关闭')\n} })\n"
                      }
                    }
                  }
                }
              },
              "saveBtn": {
                "type": "string",
                "x-component": "Button",
                "x-component-props": {
                  "children": "保存配置",
                  "type": "primary",
                  "size": "middle",
                  "icon": "SaveOutlined"
                },
                "x-reactions": {
                  "fulfill": {
                    "run": "const rf = $utils.getBlockRootField($self)\n$props({\n  onClick: async () => {\n    if (!rf) return\n    const formField = rf.query(rf.address.entire + '.translationConfigForm').take()\n    if (!formField) return\n    const config = formField.value || {}\n    if (!config.providerId) { $message.error('请选择翻译提供方'); return }\n    if (!config.modelId) { $message.error('请选择翻译模型'); return }\n    await rf.saveTranslationConfig(config)\n    $message.success('保存成功')\n  }\n})\n"
                  }
                }
              }
            }
          },
          "translationConfigForm": {
            "type": "object",
            "x-reactions": {
              "fulfill": {
                "run": "const rf = $utils.getBlockRootField($self)\n$effect(() => {\n  if (!rf || !rf.state || !rf.state.translationConfig) return\n  $self.value = rf.state.translationConfig\n  const enabledField = rf.query(rf.address.entire + '.headerDiv.enableGroup.enabled').take()\n  if (enabledField) enabledField.value = rf.state.translationConfig.enabled || false\n}, [rf.state.translationConfig])\n"
              }
            },
            "properties": {
              "modelCard": {
                "type": "void",
                "x-component": "Card",
                "x-component-props": {
                  "title": "模型配置",
                  "size": "small",
                  "style": {
                    "marginBottom": "16px"
                  }
                },
                "properties": {
                  "openProviderSettingsBtn": {
                    "type": "string",
                    "x-component": "Button",
                    "x-component-props": {
                      "children": "点我去配置模型提供方",
                      "type": "primary",
                      "size": "small",
                      "style": {
                        "margin": "0px 0px 8px 25%"
                      }
                    },
                    "x-reactions": {
                      "fulfill": {
                        "run": "$props({ onClick: async () => { const url = await $chrome.runtime.getURL('/options.html#/ModelProvidersSettings'); await $chrome.tabs.create({ url }) } })\n"
                      }
                    }
                  },
                  "providerId": {
                    "type": "string",
                    "title": "翻译提供方",
                    "required": true,
                    "x-decorator": "FormItem",
                    "x-component": "Select",
                    "x-validator": [
                      {
                        "required": true,
                        "message": "请选择翻译提供方"
                      }
                    ],
                    "x-component-props": {
                      "placeholder": "请先在模型配置中添加提供方",
                      "showSearch": true,
                      "optionFilterProp": "label"
                    },
                    "x-reactions": {
                      "fulfill": {
                        "run": "const rf = $utils.getBlockRootField($self)\nif (!rf || !rf.state) return\n$effect(() => {\n  $self.dataSource = (rf.state.modelProviderConfig || []).map((p) => ({ label: p.name, value: p.id }))\n}, [rf.state.modelProviderConfig])\n\n$props({ onChange: (val) => {\n  rf.state.selectedProviderId = val\n  const formVal = $self.parent && $self.parent.value\n  if (formVal) formVal.modelId = ''\n} })\n"
                      }
                    }
                  },
                  "modelId": {
                    "type": "string",
                    "title": "翻译模型",
                    "required": true,
                    "x-decorator": "FormItem",
                    "x-component": "Select",
                    "x-validator": [
                      {
                        "required": true,
                        "message": "请选择翻译模型"
                      }
                    ],
                    "x-component-props": {
                      "placeholder": "请先选择提供方",
                      "showSearch": true,
                      "optionFilterProp": "label"
                    },
                    "x-reactions": {
                      "fulfill": {
                        "run": "const rf = $utils.getBlockRootField($self)\nif (!rf || !rf.state) return\n$effect(() => {\n  const providerId = rf.state.selectedProviderId\n  const provider = (rf.state.modelProviderConfig || []).find((p) => p.id === providerId)\n  $self.dataSource = (provider && provider.models || []).map((m) => ({ label: m.model, value: m.model }))\n}, [rf.state.modelProviderConfig, rf.state.selectedProviderId])\n"
                      }
                    }
                  }
                }
              },
